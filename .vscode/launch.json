{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/srv/dmarc": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug ingest.php",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/bin/ingest.php",
            "cwd": "${workspaceFolder}",
            "port": 9003,
            "runtimeArgs": ["-dxdebug.start_with_request=yes"]
        },
        {
            "name": "Debug current file",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "port": 9003,
            "runtimeArgs": ["-dxdebug.start_with_request=yes"]
        }
    ]
}
